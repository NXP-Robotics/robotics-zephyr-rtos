#include <zephyr/dt-bindings/gpio/gpio.h>

/ {
	aliases {
		qdec0 = &qdc0;
		qenca = &phase_a;
		qencb = &phase_b;
	};

	/*
	 * Optional software encoder emulator: toggling these two GPIOs
	 * generates quadrature pulses that feed PHASEA/PHASEB, so the
	 * sample can be exercised without external encoder hardware.
	 */
	encoder-emulate {
		compatible = "gpio-leds";

		phase_a: phase_a {
			gpios = <&gpio2 2 GPIO_ACTIVE_HIGH>;
		};

		phase_b: phase_b {
			gpios = <&gpio2 3 GPIO_ACTIVE_HIGH>;
		};
	};
};

&gpio2 {
	status = "okay";
};

/*
 * QDEC input pins: PIO1_22 (TRIG_IN3) and PIO2_0 (TRIG_IN5)
 */
&pinctrl {
	qdc0_default: qdc0_default {
		group0 {
			pinmux = <TRIG_IN3_PIO1_22>,
				 <TRIG_IN5_PIO2_0>;
			drive-strength = "low";
			slew-rate = "fast";
			input-enable;
		};
	};
};

&inputmux0 {
	status = "okay";
};

&qdc0 {
	status = "okay";
	counts-per-revolution = <480>;
	mux-states = <&inputmux0 0 0x3700002d>,
		     <&inputmux0 0 0x36c0002f>;
	pinctrl-0 = <&qdc0_default>;
	pinctrl-names = "default";
};

